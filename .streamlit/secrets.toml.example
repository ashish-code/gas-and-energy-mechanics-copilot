# Streamlit Community Cloud secrets — paste into the app's Settings -> Secrets UI.
# DO NOT commit the real secrets.toml (it is gitignored). This .example is safe.
#
# Use a DEDICATED least-privilege IAM user for these keys (Bedrock invoke + rerank
# only) — NOT your local `vscode-user`. The IAM policy is provided at M7.
#
# The Streamlit app bridges these into os.environ at startup so src/config.py picks
# them up via the same field names as local .env.

AWS_REGION = "us-east-1"
AWS_ACCESS_KEY_ID = "AKIA...redacted..."
AWS_SECRET_ACCESS_KEY = "...redacted..."

SUPABASE_DB_URL = "postgresql://postgres.<ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres"

# Optional — enables LangSmith tracing on the deployed app.
LANGSMITH_API_KEY = ""
LANGSMITH_PROJECT = "gas-energy-copilot-v2"
LANGSMITH_TRACING = "false"

LOG_JSON = "true"
LOG_LEVEL = "INFO"
