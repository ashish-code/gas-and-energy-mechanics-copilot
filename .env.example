# Gas & Energy Mechanics Copilot v2 — local environment.
# Copy to `.env` (gitignored) and fill in. `.env` is read by src/config.py.

# --- AWS / Bedrock (region us-east-1) ---------------------------------------
AWS_REGION=us-east-1
# Local dev: use a named profile (M0 verified `vscode-user`). Leave the static
# keys blank when using a profile.
AWS_PROFILE=vscode-user
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# --- Bedrock model IDs (resolved at M0; override only to swap models) --------
# MODEL_PLANNER=us.anthropic.claude-sonnet-4-6
# MODEL_SYNTHESIZER=us.anthropic.claude-sonnet-4-6
# MODEL_EXECUTOR=us.anthropic.claude-haiku-4-5-20251001-v1:0
# MODEL_VERIFIER=us.anthropic.claude-haiku-4-5-20251001-v1:0
# MODEL_EMBEDDING=amazon.titan-embed-text-v2:0
# MODEL_RERANKER=cohere.rerank-v3-5:0

# --- Supabase Postgres (pgvector) -------------------------------------------
# Use the Supabase connection string (Project Settings -> Database -> Connection string).
# The pooler URL (port 6543, transaction mode) is recommended for serverless/Streamlit.
SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# --- LangSmith (optional; tracing is a no-op when key is unset) --------------
# LANGSMITH_API_KEY=
LANGSMITH_PROJECT=gas-energy-copilot-v2
LANGSMITH_TRACING=false

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=false   # pretty console logs locally; set true (or unset) for JSON
